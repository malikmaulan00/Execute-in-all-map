local function SaveSoundsToFile()
    if #SoundData == 0 then
        Notify("❌ Error", "No sounds found! Scan first.", 2)
        return
    end
    
    if not writefileSupported then
        Notify("❌ Error", "Writefile not supported! Use copy instead.", 2)
        return
    end
    
    local text = "=== SOUND LIST ===\n"
    text = text .. "Map: " .. game.Name .. " (" .. game.PlaceId .. ")\n"
    text = text .. "Total: " .. #SoundData .. " sounds\n"
    text = text .. "═══════════════════════\n\n"
    
    for i, sound in pairs(SoundData) do
        text = text .. string.format("%d. %s | %s\n", i, sound.Name, sound.AssetId)
        text = text .. "   Type: " .. (sound.Type or "Unknown") .. " | Parent: " .. (sound.Parent or "Unknown") .. "\n"
        if sound.Volume then
            text = text .. "   Volume: " .. sound.Volume .. " | Looped: " .. tostring(sound.Looped) .. "\n"
        end
        text = text .. "\n"
    end
    
    text = text .. "═══════════════════════\n"
    text = text .. "Exported: " .. os.date("%Y-%m-%d %H:%M:%S")
    
    local filename = "SoundList_" .. game.PlaceId .. "_" .. os.time() .. ".txt"
    local success, err = pcall(function()
        writefile(filename, text)
    end)
    
    if success then
        Notify("💾 Saved", string.format("Saved to: %s\n%d sounds", filename, #SoundData), 4)
        print("✅ SOUND LIST SAVED TO: " .. filename)
    else
        Notify("❌ Error", "Failed to save: " .. tostring(err), 3)
    end
end

local function PreviewSound(soundIndex)
    if #SoundData == 0 or not SoundData[soundIndex] then
        Notify("❌ Error", "Sound not found!", 2)
        return
    end
    
    local sound = SoundData[soundIndex]
    if sound.FullId == "" or sound.FullId == "No ID" then
        Notify("❌ Error", "Invalid sound ID!", 2)
        return
    end
    
    local preview = Instance.new("Sound")
    preview.SoundId = sound.FullId
    preview.Volume = 0.5
    preview.Looped = false
    preview.Parent = SoundService
    preview:Play()
    
    Notify("🎵 Playing", "Preview: " .. sound.Name, 3)
    
    task.delay(10, function()
        if preview and preview.Parent then
            preview:Stop()
            preview:Destroy()
        end
    end)
end

