-- ═══ UPDATE PROGRESS ═══
local function UpdateProgress(status, progress, total)
    copyProgress = progress or copyProgress
    copyTotal = total or copyTotal
    
    local percent = copyTotal > 0 and (copyProgress / copyTotal * 100) or 0
    ProgStatus.Text = status or "Processing..."
    ProgFill.Size = UDim2.new(math.clamp(percent / 100, 0, 1), 0, 1, 0)
    ProgPercent.Text = string.format("%.1f%%", percent)
    
    if percent >= 100 and copyTotal > 0 then
        TweenService:Create(ProgressFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        ProgressFrame.Visible = false
        isCopyingMap = false
        MF.Visible = true
        Notify("✅ Copy Complete", "Map copied successfully!\nItems: " .. copyTotal, 4)
    end
end

