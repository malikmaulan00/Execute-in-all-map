local function FindNearestEnemy(range)
    local nearest, nearestDist = nil, range or 100
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Parent and not Players:GetPlayerFromCharacter(v.Parent) then
            if v:FindFirstChildOfClass("Humanoid") or 
               v.Name:lower():find("enemy") or v.Name:lower():find("boss") or 
               v.Name:lower():find("mob") or v.Name:lower():find("npc") then
                if LP.Character then
                    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - v.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = v
                        end
                    end
                end
            end
        end
    end
    return nearest, nearestDist
end

local function AutoFarmGeneral()
    spawn(function()
