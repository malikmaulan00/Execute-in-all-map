            table.insert(soundList, {
                Name = name, AssetId = assetId, FullId = id,
                IsPlaying = v.Playing or false, Volume = v.Volume or 0,
                Looped = v.Looped or false, Parent = "SoundService",
                Type = id:find("rbxasset") and "Music" or "Effect"
            })
            count = count + 1
        end
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Sound") and not v:FindFirstChild("_Scanned") then
            local id = v.SoundId or ""
            local name = v.Name or "Unnamed"
            local assetId = id:match("rbxassetid://(%d+)") or id:match("asset%?id=(%d+)") or id
            if assetId == "" then assetId = "No ID" end
            
            local tag = Instance.new("BoolValue", v)
            tag.Name = "_Scanned"; tag.Value = true
            
            table.insert(soundList, {
                Name = name, AssetId = assetId, FullId = id,
                IsPlaying = v.Playing or false, Volume = v.Volume or 0,
                Looped = v.Looped or false, Parent = "Workspace",
                Type = id:find("rbxasset") and "Music" or "Effect"
            })
            count = count + 1
        end
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "_Scanned" then v:Destroy() end
    end
    
    return soundList, count
end

