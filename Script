end)

-- ═══ COPY MAP FUNCTION ═══
local function CopyMap()
    if isCopyingMap then 
        Notify("⚠️ Warning", "Copy already in progress!", 2)
        return 
    end
    
    isCopyingMap = true
    copyProgress = 0
    copyTotal = 0
    
    ProgressFrame.Visible = true
    MF.Visible = false
    UpdateProgress("Scanning map...", 0, 1)
    
    mapCopyFolder = Instance.new("Folder")
    mapCopyFolder.Name = "CopiedMap_" .. os.time()
    mapCopyFolder.Parent = CoreGui
    
    spawn(function()
        local function SafeCall(func, ...)
            local success, result = pcall(func, ...)
            if not success then warn("Error: " .. tostring(result)) end
            return success, result
        end
        
        SafeCall(function()
            local services = {
                Workspace,
                Lighting,
                SoundService,
                ReplicatedStorage,
                ServerStorage
            }
            
            local totalItems = 0
            for _, service in pairs(services) do
                for _, child in pairs(service:GetChildren()) do
                    if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Tool") or 
                       child:IsA("Sound") or child:IsA("Folder") or child:IsA("MeshPart") or
                       child:IsA("Decal") or child:IsA("Texture") or child:IsA("Script") or
                       child:IsA("LocalScript") then
                        totalItems = totalItems + 1
                    end
                end
            end
            copyTotal = totalItems
            
            if totalItems == 0 then
                UpdateProgress("No items found!", 0, 1)
                isCopyingMap = false
                ProgressFrame.Visible = false
                MF.Visible = true
                Notify("⚠️ Error", "No items found to copy!", 2)
                return
            end
            
            local currentItem = 0
            for _, service in pairs(services) do
                local serviceName = service.Name
                local serviceFolder = Instance.new("Folder")
                serviceFolder.Name = serviceName
                serviceFolder.Parent = mapCopyFolder
                
                for _, child in pairs(service:GetChildren()) do
                    if not isCopyingMap then break end
                    
                    if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Tool") or 
                       child:IsA("Sound") or child:IsA("Folder") or child:IsA("MeshPart") or
                       child:IsA("Decal") or child:IsA("Texture") or child:IsA("Script") or
                       child:IsA("LocalScript") then
                        
                        currentItem = currentItem + 1
                        UpdateProgress(string.format("Copying: %s (%d/%d)", child.Name, currentItem, totalItems), currentItem, totalItems)
                        
                        local cloned = child:Clone()
                        cloned.Parent = serviceFolder
                        
                        local meta = Instance.new("StringValue", cloned)
                        meta.Name = "_OriginalPath"
                        meta.Value = child:GetFullName()
                        
                        wait(0.01)
                    end
                end
            end
            
            if isCopyingMap then
                local mapData = {
                    timestamp = os.time(),
                    date = os.date("%Y-%m-%d %H:%M:%S"),
                    placeId = game.PlaceId,
                    placeName = game.Name,
                    totalItems = copyTotal,
                    executor = EXECUTOR_NAME
                }
                
                local dataSave = Instance.new("StringValue", mapCopyFolder)
                dataSave.Name = "MapData"
                dataSave.Value = HttpService:JSONEncode(mapData)
                
                UpdateProgress("✅ Complete!", copyTotal, copyTotal)
                
                Notify("✅ Map Copied!", 
                    string.format("Copied %d items!\n💡 Click 'Save Map to File' to save permanently.", 
                    copyTotal), 4)
            end
        end)
    end)
end

-- ═══ SAVE MAP TO FILE ═══
local function SaveMapToFile()
    if not mapCopyFolder then
        Notify("❌ Error", "No copied data found! Copy a map first.", 3)
        return false
    end
    
    if not writefileSupported then
        Notify("❌ Error", "Writefile not supported! Use copy instead.", 2)
        return false
    end
    
    local exportData = {
        timestamp = os.time(),
        date = os.date("%Y-%m-%d %H:%M:%S"),
        placeId = game.PlaceId,
        placeName = game.Name,
        totalItems = 0,
        services = {},
        executor = EXECUTOR_NAME,
        gameVersion = game.Version or "Unknown"
    }
    
    for _, serviceFolder in pairs(mapCopyFolder:GetChildren()) do
        if serviceFolder:IsA("Folder") and serviceFolder.Name ~= "MapData" then
            local serviceData = {name = serviceFolder.Name, items = {}}
            
            for _, item in pairs(serviceFolder:GetChildren()) do
                if not item:IsA("StringValue") or item.Name ~= "_OriginalPath" then
                    local itemData = {
                        name = item.Name,
                        className = item.ClassName,
                        properties = {}
                    }
                    
                    if item:IsA("BasePart") then
                        itemData.properties.position = tostring(item.Position)
                        itemData.properties.size = tostring(item.Size)
                        itemData.properties.color = tostring(item.Color)
                        itemData.properties.material = tostring(item.Material)
                        itemData.properties.transparency = item.Transparency
                        itemData.properties.anchored = item.Anchored
                        itemData.properties.canCollide = item.CanCollide
                    elseif item:IsA("Sound") then
                        itemData.properties.soundId = item.SoundId
                        itemData.properties.volume = item.Volume
                        itemData.properties.looped = item.Looped
                    elseif item:IsA("Script") or item:IsA("LocalScript") then
                        itemData.properties.source = string.sub(item.Source, 1, 500) .. "..."
                    end
                    
                    table.insert(serviceData.items, itemData)
                    exportData.totalItems = exportData.totalItems + 1
                end
            end
            
            table.insert(exportData.services, serviceData)
        end
    end
    
    local jsonData = HttpService:JSONEncode(exportData)
    local filename = "CopiedMap_" .. os.time() .. ".json"
    local saved = false
    
    pcall(function()
        writefile(filename, jsonData)
        saved = true
    end)
    
    if saved then
        Notify("💾 File Saved!", 
            string.format("✅ %s saved!\n📍 Executor: %s\n📦 Items: %d\n💾 Size: %d KB", 
            filename, EXECUTOR_NAME, exportData.totalItems, #jsonData / 1024), 5)
        return true
    else
        Notify("❌ Error", "Failed to save file!\nTry copying data to clipboard instead.", 3)
        return false
    end
end

-- ═══ LOAD MAP FROM FILE ═══
local function LoadMapFromFile()
    local files = {}
    pcall(function()
        local allFiles = listfiles("/")
        for _, file in pairs(allFiles) do
            if file:match("CopiedMap_.*%.json") then
                table.insert(files, file)
            end
        end
    end)
    
    if #files == 0 then
        Notify("❌ Error", "No saved map files found!", 3)
        return nil
    end
    
    table.sort(files)
    local latestFile = files[#files]
    local data = nil
    
    pcall(function()
        data = readfile(latestFile)
    end)
    
    if data then
        local parsed = HttpService:JSONDecode(data)
        Notify("📂 File Loaded!", 
            string.format("✅ %s loaded!\n📦 Items: %d\n📅 Date: %s", 
            latestFile:gsub("./", ""), parsed.totalItems, parsed.date), 4)
        return parsed
    else
        Notify("❌ Error", "Failed to load file!", 3)
        return nil
    end
end

